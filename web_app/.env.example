# 任职资格认证 AI 初筛系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-api-key-here

# AI 模型（可选，默认 deepseek-V4-pro）
AI_MODEL=deepseek-V4-pro

# AI API 地址（可选，默认 DeepSeek 兼容 Anthropic 端点）
AI_BASE_URL=https://api.deepseek.com/anthropic

# 最大 Token 数（可选，默认 8192）
AI_MAX_TOKENS=8192

# Flask 密钥（可选，生产环境请修改）
SECRET_KEY=change-me-in-production
